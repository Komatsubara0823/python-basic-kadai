      "source": [
        "class Human:\n",
        "    # コンストラクタを定義する\n",
        "    def __init__(self):\n",
        "        self.name = \"\"\n",
        "\n",
        "    def printinfo(self, name, age):\n",
        "        self.name = name\n",
        "        self.age = age\n",
        "        print(self.name, self.age)\n",
        "\n",
        "# インスタンス化する\n",
        "human = Human()\n",
        "\n",
        "human.printinfo(\"侍太郎\", 36)"
      ]
    }
  ]
